# Real session data: never commit
prototype/transcripts.js
prototype/transcripts.js.tmp
# real SDK logs an old checkout may still hold
spike/logs/

# Dependencies and OS files
node_modules/
.DS_Store

# Built app bundles
*.app/
build/
# ...but a harness plugin's rendered agents are its build/agents/ (app/harness/pin.sh)
!app/harness/bundle/build/
!app/backend/test/fixtures/harness/build/
# your agent-harness checkout for app/build.sh, one line holding its path
app/.harness-live

# Synopia app: dev state and local-only fixtures
app/.dev-state/
app/backend/test/fixtures/local/

# Agent worktrees (the Agent tool's isolation: worktree)
.claude/worktrees/
