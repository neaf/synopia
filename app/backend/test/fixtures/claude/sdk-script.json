      { "ago": 240000, "ask": { "id": "req-question-1", "tool": "AskUserQuestion", "toolUseId": "toolu_ask2", "input": { "questions": [
        { "question": "Ship it today?", "header": "Ship", "multiSelect": false, "options": [
          { "label": "Yes (recommended)", "description": "Today, after the checks pass" },
          { "label": "No", "description": "Next week, with the docs" } ] },
        { "question": "Which pages get the banner?", "header": "Pages", "multiSelect": true, "options": [
          { "label": "Home", "description": "The landing page" },
          { "label": "Docs", "description": "Every docs page" },
          { "label": "Blog", "description": "Only new posts" } ] }
      ] } } },
      { "after": 3000, "message": { "type": "result", "subtype": "success", "is_error": false, "result": "", "duration_ms": 3000, "num_turns": 1 } },
      { "message": { "type": "system", "subtype": "session_state_changed", "state": "idle" } }
    ] },

    "33333333-0000-4000-8000-000000000003": { "state": { "cwd": "/Users/fixture/dev/demo" }, "start": true, "steps": [
      { "ago": 120000, "message": { "type": "system", "subtype": "session_state_changed", "state": "running" } },
      { "ago": 120000, "ask": { "id": "req-permission-1", "tool": "Bash", "toolUseId": "toolu_fake_push1",
        "input": { "command": "git push origin demo-banner", "description": "Push the banner branch so CI runs the demo build on it." },
        "suggestions": [ { "type": "addRules", "rules": [{ "toolName": "Bash", "ruleContent": "git push:*" }], "behavior": "allow", "destination": "localSettings" } ] } },
