{
  "about": "Script for the scripted SDK (app/backend/dev/scripted-sdk.ts, --sdk-script). Made up. A step's `after` is ms after the step before, `ago` how far in the past it plays; an `ask` waits for its answer. 11111111 is idle with a process (the menu comes from it); 22222222, 33333333 and 55555555 wait on a question, a permission with an \"Always allow\" suggestion and a plan, and work 3 s once answered; 44444444 works, with a stream preview. A message that starts a turn is worked on for 3 s.",
  "home": "/Users/fixture",
  "menu": {
    "models": [
      { "value": "default", "displayName": "Default", "description": "Use the default model (currently Fixture Large (Default))", "supportedEffortLevels": ["low", "medium", "high"] },
      { "value": "fixture-large", "displayName": "Fixture Large", "description": "The larger fixture model", "supportedEffortLevels": ["low", "medium", "high"] },
      { "value": "fixture-small", "displayName": "Fixture Small", "description": "The fast fixture model", "supportedEffortLevels": [] }
    ],
    "commands": [
      { "name": "clear", "description": "Clear the conversation", "argumentHint": "", "builtin": true },
      { "name": "compact", "description": "Summarise the conversation to free context", "argumentHint": "[instructions]", "builtin": true },
      { "name": "model", "description": "Choose the model for this session", "argumentHint": "", "builtin": true },
      { "name": "plan", "description": "Plan before changing files", "argumentHint": "", "builtin": true },
      { "name": "pr-review", "description": "Review a pull request", "argumentHint": "&lt;number&gt;" },
      { "name": "release-notes", "description": "Draft release notes from merged work", "argumentHint": "" },
      { "name": "fixture:deploy", "description": "Deploy the fixture app", "argumentHint": "&lt;env&gt;" },
      { "name": "__internal", "description": "Hidden from the menu", "argumentHint": "" }
    ]
  },
  "onSend": [
    { "after": 3000, "message": { "type": "result", "subtype": "success", "is_error": false, "result": "", "duration_ms": 3000, "num_turns": 1 } },
    { "message": { "type": "system", "subtype": "session_state_changed", "state": "idle" } }
  ],
  "sessions": {
